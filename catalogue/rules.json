{
  "properties": [
    { "name": "TreatWarningsAsErrors", "value": "true", "level": "Baseline", "since": "1.0.0", "description": "Every reported warning fails the build." },
    { "name": "EnforceCodeStyleInBuild", "value": "true", "level": "Baseline", "since": "1.0.0", "description": "Code style (IDE) rules run in the build, not only in the editor." },
    { "name": "EnableNETAnalyzers", "value": "true", "level": "Baseline", "since": "1.0.0", "description": "The .NET SDK code analysis rules run in every project, including .NET Standard ones." },
    { "name": "AnalysisLevel", "value": "8.0", "level": "Baseline", "since": "1.0.0", "description": "Which SDK rules exist is pinned per HouseRules major, so an SDK update adds no rules." },
    { "name": "Deterministic", "value": "true", "level": "Baseline", "since": "1.0.0", "description": "Identical source gives identical binaries." },
    { "name": "ContinuousIntegrationBuild", "value": "true", "condition": "'$(CI)' == 'true'", "level": "Baseline", "since": "1.0.0", "description": "CI builds embed normalised paths." },
    { "name": "GenerateDocumentationFile", "value": "true", "level": "Recommended", "since": "1.0.0", "description": "Lets IDE0005 (unused usings) run in the build; missing doc comments (CS1591) stay off." },
    { "name": "Nullable", "value": "enable", "level": "Strict", "since": "1.0.0", "description": "Nullable reference types." },
    { "name": "Features", "value": "strict", "level": "Strict", "since": "1.0.0", "description": "The compiler's strict mode." },
    { "name": "WarningLevel", "value": "9999", "level": "Strict", "since": "1.0.0", "description": "Every compiler warning wave." },
    { "name": "CheckForOverflowUnderflow", "value": "true", "condition": "'$(Configuration)' == 'Debug' or '$(Configuration)' == ''", "level": "Strict", "since": "1.0.0", "description": "Checked arithmetic in Debug builds: overflow is a bug, not a wrap-around." }
  ],
  "categories": [
    { "name": "Security", "mode": "All", "level": "Baseline", "since": "1.0.0" },
    { "name": "Reliability", "mode": "All", "level": "Baseline", "since": "1.0.0" },
    { "name": "Usage", "mode": "All", "level": "Recommended", "since": "1.0.0" },
    { "name": "Performance", "mode": "Recommended", "level": "Recommended", "since": "1.0.0" },
    { "name": "Maintainability", "mode": "Recommended", "level": "Recommended", "since": "1.0.0" },
    { "name": "Design", "mode": "Recommended", "level": "Recommended", "since": "1.0.0" },
    { "name": "Naming", "mode": "Recommended", "level": "Recommended", "since": "1.0.0" },
    { "name": "Globalization", "mode": "Recommended", "level": "Recommended", "since": "1.0.0" }
  ],
  "banned": [
    { "category": "WeakCrypto", "switch": "HouseRulesBanWeakCrypto", "level": "Baseline", "since": "1.0.0", "description": "Broken hashes and ciphers (MD5, SHA1, DES, TripleDES, RC2)." },
    { "category": "HttpClient", "switch": "HouseRulesBanHttpClient", "level": "Baseline", "since": "1.0.0", "description": "Constructing HttpClient or WebClient directly." },
    { "category": "WallClock", "switch": "HouseRulesBanWallClock", "level": "Recommended", "since": "1.0.0", "description": "Reading the clock directly (DateTime.Now, UtcNow, Today; DateTimeOffset.Now, UtcNow)." },
    { "category": "Random", "switch": "HouseRulesBanRandom", "level": "Recommended", "since": "1.0.0", "description": "System.Random." },
    { "category": "Console", "switch": "HouseRulesBanConsole", "level": "Recommended", "since": "1.0.0", "description": "System.Console." },
    { "category": "Environment", "switch": "HouseRulesBanEnvironment", "level": "Recommended", "since": "1.0.0", "description": "Reading environment variables directly." }
  ],
  "rules": [
    { "id": "HR0001", "source": "HouseRules", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": true, "description": "Blank line after a multi-line statement." },
    { "id": "IDE0055", "source": "IDE", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": true, "description": "Formatting: Allman braces, indentation, spacing.", "options": {
      "csharp_new_line_before_open_brace": "all",
      "csharp_new_line_before_else": "true",
      "csharp_new_line_before_catch": "true",
      "csharp_new_line_before_finally": "true",
      "csharp_new_line_before_members_in_object_initializers": "true",
      "csharp_new_line_before_members_in_anonymous_types": "true",
      "csharp_new_line_between_query_expression_clauses": "true",
      "csharp_indent_case_contents": "true",
      "csharp_indent_switch_labels": "true",
      "csharp_indent_labels": "one_less_than_current",
      "csharp_indent_block_contents": "true",
      "csharp_indent_braces": "false",
      "csharp_indent_case_contents_when_block": "false",
      "csharp_space_after_cast": "false",
      "csharp_space_after_keywords_in_control_flow_statements": "true",
      "csharp_space_around_binary_operators": "before_and_after",
      "csharp_space_between_method_declaration_parameter_list_parentheses": "false",
      "csharp_space_between_method_call_parameter_list_parentheses": "false",
      "csharp_space_between_parentheses": "false",
      "csharp_space_after_comma": "true",
      "csharp_space_after_dot": "false",
      "csharp_space_after_semicolon_in_for_statement": "true",
      "csharp_space_before_colon_in_inheritance_clause": "true",
      "csharp_space_after_colon_in_inheritance_clause": "true",
      "csharp_preserve_single_line_blocks": "true",
      "csharp_preserve_single_line_statements": "false",
      "dotnet_sort_system_directives_first": "true",
      "dotnet_separate_import_directive_groups": "true"
    } },
    { "id": "IDE0011", "source": "IDE", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": true, "description": "Braces on every if, else, for, foreach, while and using body.", "options": { "csharp_prefer_braces": "true" } },
    { "id": "IDE0161", "source": "IDE", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": true, "description": "File-scoped namespaces.", "options": { "csharp_style_namespace_declarations": "file_scoped" } },
    { "id": "IDE0065", "source": "IDE", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": true, "description": "Using directives outside the namespace.", "options": { "csharp_using_directive_placement": "outside_namespace" } },
    { "id": "RCS0056", "source": "Roslynator", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": true, "description": "Lines are at most 120 characters long.", "options": { "roslynator_max_line_length": "120" } },
    { "id": "RCS0054", "source": "Roslynator", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": true, "description": "Once a call chain wraps, one call per line." },
    { "id": "RCS0053", "source": "Roslynator", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": true, "description": "Argument and parameter lists: on one line, or one element per line." },
    { "id": "RCS0032", "source": "Roslynator", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": true, "description": "A wrapped expression body breaks after `=>`.", "options": { "roslynator_arrow_token_new_line": "after" } },
    { "id": "RCS0052", "source": "Roslynator", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": true, "description": "A wrapped assignment breaks after `=`.", "options": { "roslynator_equals_token_new_line": "after" } },
    { "id": "RCS0027", "source": "Roslynator", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": true, "description": "A wrapped binary expression puts the operator first on the new line.", "options": { "roslynator_binary_operator_new_line": "before" } },
    { "id": "RCS0028", "source": "Roslynator", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": true, "description": "A wrapped conditional expression puts `?` and `:` first on the new line.", "options": { "roslynator_conditional_operator_new_line": "before" } },
    { "id": "RCS0059", "source": "Roslynator", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": true, "description": "A wrapped null-conditional access puts `?.` first on the new line.", "options": { "roslynator_null_conditional_operator_new_line": "before" } },
    { "id": "RCS0055", "source": "Roslynator", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": true, "description": "Once a binary expression wraps, it breaks at every operator." },
    { "id": "RS0030", "source": "BannedApiAnalyzers", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": false, "description": "Banned APIs (see the ban categories)." },
    { "id": "CA2100", "source": "CA", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": false, "description": "SQL built from strings is reviewed for injection." },
    { "id": "CA3075", "source": "CA", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": false, "description": "No insecure DTD processing in XML." },
    { "id": "CA5350", "source": "CA", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": false, "description": "No weak cryptographic algorithms." },
    { "id": "CA5351", "source": "CA", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": false, "description": "No broken cryptographic algorithms." },
    { "id": "CA5394", "source": "CA", "severity": "warning", "level": "Baseline", "since": "1.0.0", "fixable": false, "description": "No insecure randomness." },
    { "id": "CA2007", "source": "CA", "severity": "none", "level": "Baseline", "since": "1.0.0", "fixable": false, "description": "Off: ConfigureAwait on every await is noise in apps without a synchronization context." },

    { "id": "IDE1006", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Naming: IPrefix interfaces, TPrefix type parameters, PascalCase types and members, _camelCase private fields, camelCase locals and parameters, Async suffix on async methods.", "options": {
      "dotnet_naming_rule.interfaces_begin_with_i.symbols": "interfaces",
      "dotnet_naming_rule.interfaces_begin_with_i.style": "prefix_i",
      "dotnet_naming_rule.interfaces_begin_with_i.severity": "warning",
      "dotnet_naming_symbols.interfaces.applicable_kinds": "interface",
      "dotnet_naming_style.prefix_i.capitalization": "pascal_case",
      "dotnet_naming_style.prefix_i.required_prefix": "I",
      "dotnet_naming_rule.type_parameters_begin_with_t.symbols": "type_parameters",
      "dotnet_naming_rule.type_parameters_begin_with_t.style": "prefix_t",
      "dotnet_naming_rule.type_parameters_begin_with_t.severity": "warning",
      "dotnet_naming_symbols.type_parameters.applicable_kinds": "type_parameter",
      "dotnet_naming_style.prefix_t.capitalization": "pascal_case",
      "dotnet_naming_style.prefix_t.required_prefix": "T",
      "dotnet_naming_rule.types_and_members_pascal.symbols": "types_and_members",
      "dotnet_naming_rule.types_and_members_pascal.style": "pascal_case",
      "dotnet_naming_rule.types_and_members_pascal.severity": "warning",
      "dotnet_naming_symbols.types_and_members.applicable_kinds": "class, struct, enum, delegate, method, property, event, namespace, local_function",
      "dotnet_naming_rule.constants_pascal.symbols": "constants",
      "dotnet_naming_rule.constants_pascal.style": "pascal_case",
      "dotnet_naming_rule.constants_pascal.severity": "warning",
      "dotnet_naming_symbols.constants.applicable_kinds": "field, local",
      "dotnet_naming_symbols.constants.required_modifiers": "const",
      "dotnet_naming_rule.static_readonly_pascal.symbols": "static_readonly_fields",
      "dotnet_naming_rule.static_readonly_pascal.style": "pascal_case",
      "dotnet_naming_rule.static_readonly_pascal.severity": "warning",
      "dotnet_naming_symbols.static_readonly_fields.applicable_kinds": "field",
      "dotnet_naming_symbols.static_readonly_fields.required_modifiers": "static, readonly",
      "dotnet_naming_rule.private_fields_underscore.symbols": "private_fields",
      "dotnet_naming_rule.private_fields_underscore.style": "underscore_camel_case",
      "dotnet_naming_rule.private_fields_underscore.severity": "warning",
      "dotnet_naming_symbols.private_fields.applicable_kinds": "field",
      "dotnet_naming_symbols.private_fields.applicable_accessibilities": "private, protected, private_protected",
      "dotnet_naming_rule.parameters_and_locals_camel.symbols": "parameters_and_locals",
      "dotnet_naming_rule.parameters_and_locals_camel.style": "camel_case",
      "dotnet_naming_rule.parameters_and_locals_camel.severity": "warning",
      "dotnet_naming_symbols.parameters_and_locals.applicable_kinds": "parameter, local",
      "dotnet_naming_rule.async_methods_end_with_async.symbols": "async_methods",
      "dotnet_naming_rule.async_methods_end_with_async.style": "end_with_async",
      "dotnet_naming_rule.async_methods_end_with_async.severity": "warning",
      "dotnet_naming_symbols.async_methods.applicable_kinds": "method",
      "dotnet_naming_symbols.async_methods.required_modifiers": "async",
      "dotnet_naming_style.pascal_case.capitalization": "pascal_case",
      "dotnet_naming_style.camel_case.capitalization": "camel_case",
      "dotnet_naming_style.underscore_camel_case.capitalization": "camel_case",
      "dotnet_naming_style.underscore_camel_case.required_prefix": "_",
      "dotnet_naming_style.end_with_async.capitalization": "pascal_case",
      "dotnet_naming_style.end_with_async.required_suffix": "Async"
    } },
    { "id": "IDE0005", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "No unused using directives." },
    { "id": "CS1591", "source": "CS", "severity": "none", "level": "Recommended", "since": "1.0.0", "fixable": false, "description": "Off: documentation files are generated for IDE0005, doc comments stay optional." },
    { "id": "CA2016", "source": "CA", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Pass the CancellationToken on when the callee accepts one." },
    { "id": "IDE0040", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Explicit accessibility modifiers.", "options": { "dotnet_style_require_accessibility_modifiers": "for_non_interface_members" } },
    { "id": "IDE0044", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Fields that never change are readonly.", "options": { "dotnet_style_readonly_field": "true" } },
    { "id": "IDE0036", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Modifiers in one order.", "options": { "csharp_preferred_modifier_order": "public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async" } },
    { "id": "IDE0003", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "No `this.` qualification.", "options": {
      "dotnet_style_qualification_for_field": "false",
      "dotnet_style_qualification_for_property": "false",
      "dotnet_style_qualification_for_method": "false",
      "dotnet_style_qualification_for_event": "false"
    } },
    { "id": "IDE0009", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "No `this.` qualification (the opposite preference is off)." },
    { "id": "IDE0049", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Language keywords over BCL type names (`string`, not `String`).", "options": {
      "dotnet_style_predefined_type_for_locals_parameters_members": "true",
      "dotnet_style_predefined_type_for_member_access": "true"
    } },
    { "id": "IDE0017", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Object initializers.", "options": { "dotnet_style_object_initializer": "true" } },
    { "id": "IDE0028", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Collection initializers.", "options": { "dotnet_style_collection_initializer": "true" } },
    { "id": "IDE0300", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Collection expressions for arrays.", "options": { "dotnet_style_prefer_collection_expression": "when_types_loosely_match" } },
    { "id": "IDE0305", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Collection expressions instead of fluent `ToList()`/`ToArray()` calls." },
    { "id": "IDE0029", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "`??` instead of a null-check ternary.", "options": { "dotnet_style_coalesce_expression": "true" } },
    { "id": "IDE0030", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "`??` for nullable value types." },
    { "id": "IDE0031", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "`?.` instead of a null-check ternary.", "options": { "dotnet_style_null_propagation": "true" } },
    { "id": "IDE0041", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "`is null` instead of `ReferenceEquals`.", "options": { "dotnet_style_prefer_is_null_check_over_reference_equality_method": "true" } },
    { "id": "IDE0032", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Auto-properties instead of a property over a private field.", "options": { "dotnet_style_prefer_auto_properties": "true" } },
    { "id": "IDE0075", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Simplified conditional expressions.", "options": { "dotnet_style_prefer_simplified_boolean_expressions": "true" } },
    { "id": "IDE0037", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Inferred tuple and anonymous type member names.", "options": {
      "dotnet_style_prefer_inferred_tuple_names": "true",
      "dotnet_style_prefer_inferred_anonymous_type_member_names": "true"
    } },
    { "id": "IDE0054", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Compound assignment (`x += 1`).", "options": { "dotnet_style_prefer_compound_assignment": "true" } },
    { "id": "IDE0074", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Coalesce compound assignment (`x ??= y`)." },
    { "id": "IDE0071", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Simplified interpolation.", "options": { "dotnet_style_prefer_simplified_interpolation": "true" } },
    { "id": "IDE0019", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Pattern matching instead of `as` plus a null check.", "options": { "csharp_style_pattern_matching_over_as_with_null_check": "true" } },
    { "id": "IDE0020", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Pattern matching instead of `is` plus a cast.", "options": { "csharp_style_pattern_matching_over_is_with_cast_check": "true" } },
    { "id": "IDE0083", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "`is not` patterns.", "options": { "csharp_style_prefer_not_pattern": "true" } },
    { "id": "IDE0150", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "A null check instead of a type check when the type is known.", "options": { "csharp_style_prefer_null_check_over_type_check": "true" } },
    { "id": "IDE1005", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "`?.Invoke` for delegates.", "options": { "csharp_style_conditional_delegate_call": "true" } },
    { "id": "IDE0018", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Inline `out` variable declarations.", "options": { "csharp_style_inlined_variable_declaration": "true" } },
    { "id": "IDE0056", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Index operator (`^1`).", "options": { "csharp_style_prefer_index_operator": "true" } },
    { "id": "IDE0057", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Range operator (`a..b`).", "options": { "csharp_style_prefer_range_operator": "true" } },
    { "id": "IDE0090", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Target-typed `new()` when the type is apparent.", "options": { "csharp_style_implicit_object_creation_when_type_is_apparent": "true" } },
    { "id": "IDE0034", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "`default` instead of `default(T)`.", "options": { "csharp_prefer_simple_default_expression": "true" } },
    { "id": "IDE0063", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Using declarations instead of using blocks.", "options": { "csharp_prefer_simple_using_statement": "true" } },
    { "id": "IDE0039", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Local functions instead of lambdas stored in locals.", "options": { "csharp_style_prefer_local_over_anonymous_function": "true" } },
    { "id": "IDE0062", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Static local functions when nothing is captured.", "options": { "csharp_prefer_static_local_function": "true" } },
    { "id": "IDE0170", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "Extended property patterns.", "options": { "csharp_style_prefer_extended_property_pattern": "true" } },
    { "id": "IDE0051", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "No unused private members." },
    { "id": "IDE0052", "source": "IDE", "severity": "warning", "level": "Recommended", "since": "1.0.0", "fixable": true, "description": "No private members that are written but never read." },
