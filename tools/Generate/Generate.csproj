<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>HouseRules.Generate</RootNamespace>
    <!-- A command-line tool reports to the console; this is the documented opt-out, not an exemption. -->
    <HouseRulesBanConsole>false</HouseRulesBanConsole>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Downloaded only to read its rule ids; it never runs as an analyzer here. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="NetAnalyzersPath" Value="$(PkgMicrosoft_CodeAnalysis_NetAnalyzers)" />
  </ItemGroup>

</Project>
