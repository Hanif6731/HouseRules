<Project>

  <!-- The repo builds under its own standard at the strictest level, from source. -->
  <PropertyGroup>
    <HouseRulesLevel>Strict</HouseRulesLevel>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)src/HouseRules.Analyzers.Package/buildTransitive/HouseRules.Analyzers.props" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The package ships bare assemblies; an embedded PDB carries Source Link to consumers' debuggers. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Md. Hanif</Authors>
    <Copyright>Copyright (c) 2026 Md. Hanif</Copyright>
    <RepositoryUrl>https://github.com/Hanif6731/HouseRules</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
