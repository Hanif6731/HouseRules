<Project>

  <Target Name="HouseRulesCheckLevel" BeforeTargets="CoreCompile">
    <!-- With both properties, NuGet imports the package's .props only for a TargetFramework known before the project
         file, so this file runs without it. -->
    <Error
      Condition="'$(_HouseRulesConfig)' == '' and '$(TargetFramework)' != '' and '$(TargetFrameworks)' != ''"
      Text="This project sets both TargetFramework ($(TargetFramework)) and TargetFrameworks ($(TargetFrameworks)), so NuGet did not import HouseRules.Analyzers.props and none of HouseRules' build settings apply. Keep only one of the two properties." />
    <Error
      Condition="'$(_HouseRulesRank)' == '0'"
      Text="HouseRulesLevel is '$(HouseRulesLevel)'. Set it to Baseline, Recommended or Strict." />
    <Error
      Condition="'$(_HouseRulesRank)' != '0' and '$(HouseRulesLevel)' != '$(_HouseRulesLevelAtProps)'"
      Text="HouseRulesLevel changes from '$(_HouseRulesLevelAtProps)' to '$(HouseRulesLevel)' in the project file, after HouseRules has applied the build settings for '$(_HouseRulesLevelAtProps)'. Set HouseRulesLevel in Directory.Build.props or on the command line. For this project alone, use a Directory.Build.props next to it that first imports the parent one: &lt;Import Project=&quot;%24([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '%24(MSBuildThisFileDirectory)../'))&quot; /&gt;" />
  </Target>

  <!-- The ratchet: houserules.baseline next to the project records existing findings, which the build then tolerates
       while every new finding still fails it. -p:HouseRulesBaseline=init creates the file, -p:HouseRulesBaseline=prune
       drops the entries that no longer occur. -->
  <PropertyGroup>
    <_HouseRulesBaselineFile>$(MSBuildProjectDirectory)/houserules.baseline</_HouseRulesBaselineFile>
    <_HouseRulesTasksAssembly Condition="'$(_HouseRulesTasksAssembly)' == ''">$(MSBuildThisFileDirectory)../tasks/netstandard2.0/HouseRules.Tasks.dll</_HouseRulesTasksAssembly>
    <_HouseRulesBaselineActive Condition="'$(HouseRulesBaseline)' == 'init' or ('$(HouseRulesBaseline)' == 'prune' and Exists('$(_HouseRulesBaselineFile)'))">true</_HouseRulesBaselineActive>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(_HouseRulesBaselineFile)')">
    <AdditionalFiles Include="$(_HouseRulesBaselineFile)" />
  </ItemGroup>

  <UsingTask TaskName="HouseRules.Tasks.WriteBaseline" AssemblyFile="$(_HouseRulesTasksAssembly)" />

  <Target Name="HouseRulesBaselinePrepare" BeforeTargets="CoreCompile" Condition="'$(HouseRulesBaseline)' != ''">
    <Error
      Condition="'$(HouseRulesBaseline)' != 'init' and '$(HouseRulesBaseline)' != 'prune'"
      Text="HouseRulesBaseline is '$(HouseRulesBaseline)'. Use init to record the current findings or prune to drop the fixed ones." />
    <Error
      Condition="'$(HouseRulesBaseline)' == 'init' and Exists('$(_HouseRulesBaselineFile)')"
      Text="$(_HouseRulesBaselineFile) already exists, and a baseline never grows. Fix findings, then run: dotnet build -p:HouseRulesBaseline=prune" />
    <!-- The property reaches every project of a solution and every project reference, so a project without a
         baseline builds as usual. -->
    <Message
      Condition="'$(_HouseRulesBaselineActive)' != 'true'"
      Importance="high"
      Text="HouseRules: $(MSBuildProjectName) has no $(_HouseRulesBaselineFile), so there is nothing to prune." />
    <Error
      Condition="'$(_HouseRulesBaselineActive)' == 'true' and $(TargetFrameworks.Contains(';'))"
      Text="HouseRulesBaseline does not support projects with several target frameworks ($(TargetFrameworks)): each framework would overwrite the other's houserules.baseline. Fix this project's findings before raising its level." />

    <!-- Every finding must reach the error log, so warnings stay warnings. -->
    <PropertyGroup Condition="'$(_HouseRulesBaselineActive)' == 'true'">
      <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
      <_HouseRulesErrorLog>$(IntermediateOutputPath)houserules.sarif</_HouseRulesErrorLog>
      <ErrorLog>$(_HouseRulesErrorLog),version=2.1</ErrorLog>
    </PropertyGroup>
  </Target>

  <!-- Every build records whether it ran in a baseline mode. Switching modes changes the file, so the compiler runs
       again instead of trusting output built with warnings not treated as errors. -->
  <Target Name="HouseRulesRecordBuildMode" BeforeTargets="CoreCompile">
    <WriteLinesToFile
      File="$(IntermediateOutputPath)houserules.mode"
      Lines="mode=$(HouseRulesBaseline)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <CustomAdditionalCompileInputs Include="$(IntermediateOutputPath)houserules.mode" />
    </ItemGroup>
  </Target>

  <Target Name="HouseRulesBaselineWrite" AfterTargets="CoreCompile" Condition="'$(_HouseRulesBaselineActive)' == 'true'">
    <WriteBaseline Mode="$(HouseRulesBaseline)" ErrorLog="$(_HouseRulesErrorLog)" BaselineFile="$(_HouseRulesBaselineFile)" />
  </Target>

</Project>
