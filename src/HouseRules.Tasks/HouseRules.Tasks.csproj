<Project Sdk="Microsoft.NET.Sdk">

  <!-- MSBuild task that writes and prunes houserules.baseline; it only loads when a baseline mode is requested. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- MSBuild provides these assemblies at run time. -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\HouseRules.Analyzers\BaselineKey.cs" Link="BaselineKey.cs" />
  </ItemGroup>

</Project>
